<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body {
        max-width: 480px;
        margin: 40px auto;
        padding: 0 20px;
        font-family: Arial, sans-serif;
        line-height: 1.5;
      }
      form {
        display: grid;
        gap: 8px;
        margin: 16px 0;
      }
      input {
        padding: 10px;
        font-size: 16px;
      }
      button {
        padding: 10px 16px;
        font-size: 15px;
        cursor: pointer;
      }
      .errors {
        padding: 8px 14px;
        color: #991b1b;
        background: #fee2e2;
        border-radius: 6px;
      }
      .errors p,
      .errors ul {
        margin: 0;
      }
    </style>
  </head>
  <body></body>
</html>
